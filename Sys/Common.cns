[Statedef 0];敵が入ってきたときのことを考えてそのままに
type = U
movetype = U
physics = U
juggle = 0
hitdefpersist = 1
movehitpersist = 1
hitcountpersist = 1

[State ALL];敵かヘルパーが来たら飛ばす
type = ChangeState
trigger1 = !ishelper && !(numexplod(468746114)=var(58)&&(var(58)=[1,12]))
trigger2 = ishelper
value = 1141514113
persistent = 256
ignorehitpause = 1

[State ALL];論外カラーではステ固定
type = SelfState
trigger1 = var(58) = 5
value = 55
persistent = 256
ignorehitpause = 1

[State 0,0];140利用ガーステ化後
type = SelfState
trigger1 = var(58) > 9
trigger1 = !(!(var(20)&4194304))
value = 3
persistent = 256
ignorehitpause = 1

[State ALL];Time変数初期化
type = VarSet
trigger1 = stateno != sysvar(3)
sysvar(2) = 0 + (var(9):=sysvar(3)) * 0
ignorehitpause = 1

[State ALL];HitDefの引き継ぎをしているので意図していないHitDefの消去が必要
type = HitDef
trigger1 = 1
attr = 
ignorehitpause = 1

[State 0,1];StateType,Physicsは変数管理
type = StateTypeSet
trigger1 = sysvar(2) = 0
trigger1 = var(5) := (var(5)&(63^-1)) || 1
trigger1 = var(5) := (var(5)|1) || 1
trigger1 = var(5) := (var(5)|8) || 1
statetype = S
movetype = I
physics = S
ignorehitpause = 1

[State 0,2];フライング防止
type = CtrlSet
triggerall = roundstate = [2,3]
trigger1 = !(var(20)&16)
trigger1 = var(20) := (var(20)&(4^-1)) || 1
trigger2 = !(!(var(20)&16))
trigger2 = var(20) := (var(20)|4) || 1
value = !(!(var(20)&16))
ignorehitpause = 1

[State 0,3]
type = ChangeAnim
trigger1 = anim && anim != 5
trigger2 = anim = 5 && !(!(var(20)&268435456))
value = 0 + ((var(26):=-1)&&0) + ((var(20):=(var(20)&(268435456^-1)))&&0)
ignorehitpause = 1

[State 0,4];FaceEnemy再現
type = Turn
trigger1 = sysvar(2) = 0
trigger1 = roundstate = 2
trigger1 = fvar(6) < 0
ignorehitpause = 1

[State 0,5]
type = VelSet
trigger1 = sysvar(2) = 0
y = 0
ignorehitpause = 1

[State 0,6]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = sysvar(2) = 4
x = 0
ignorehitpause = 1

[State 0,7]
type = SelfState
trigger1 = ifelse(var(58)<5,!var(6),!sysfvar(4))
trigger1 = !alive && !numexplod(351711)
value = 5050
persistent = 256
ignorehitpause = 1

[State 0,8]
type = SelfState
trigger1 = ifelse(var(58)<5,!var(6),!sysfvar(4))
trigger1 = !alive && numexplod(351711)
trigger1 = roundstate = 4
value = 170
persistent = 256
ignorehitpause = 1

[State ALL];Time変数増加
Type = VarAdd
trigger1 = 1
sysvar(2) = 1
ignorehitpause = 1

[State ALL];速度・位置・ステート番号保存
type = VarSet
trigger1 = fvar(0):=vel x||fvar(1):=vel y||fvar(2):=pos x||fvar(3):=pos y||1
sysvar(3) = stateno
ignorehitpause = 1

[State ALL];準ステ固定
type = SelfState
trigger1 = var(58) > 9
trigger2 = roundstate > 2 && var(58) = [7,9]
value = 5150
persistent = 256
ignorehitpause = 1

