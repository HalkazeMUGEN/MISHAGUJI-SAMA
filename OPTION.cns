;ヘルパーステ固定
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[State -2]
type = PlayerPush
trigger1 = ishelper
value = 0
ignorehitpause = 1

[State -2]
type = ScreenBound
trigger1 = ishelper
value = 0
ignorehitpause = 1

[State -2]
type = NotHitBy
trigger1 = ishelper
value = SCA,AA,AT,AP
ignorehitpause = 1

[State -2]
type = NotHitBy
trigger1 = ishelper
value2 = SCA,AA,AT,AP
ignorehitpause = 1

[State -2]
type = AssertSpecial
trigger1 = ishelper
flag = NoShadow
ignorehitpause = 1

[State -2];対直死用ヘルパーNoKO
type = AssertSpecial
trigger1 = ishelper
trigger1 = root,var(58) = [7,9]
trigger1 = roundstate = 2
trigger1 = !root,alive || root,lose
trigger1 = root,sysfvar(4)
flag = NoKO
ignorehitpause = 1

[State -2];対直死用ラウンド移行阻止
type = AssertSpecial
trigger1 = ishelper
trigger1 = root,var(58) = [7,9]
trigger1 = roundstate = 2
trigger1 = !root,alive
trigger1 = root,sysfvar(4)
flag = NoKO
flag2 = RoundNotOver
flag3 = TimerFreeze
ignorehitpause = 1

[State -2];直死感知ペナルティ
type = AssertSpecial
trigger1 = ishelper
trigger1 = root,var(58) = [7,9]
trigger1 = roundstate = 4
trigger1 = !win
trigger1 = root,sysvar(1) < 1
trigger1 = root,numexplod(1646180000)
flag = RoundNotOver
ignorehitpause = 1

[State -2]
type = Null
trigger1 = ishelper(510908551) || ishelper(510908552)
trigger1 = var(1) := floor(1000*sin(gametime*pi/180)+0.5) || 1
trigger1 = var(2) := floor(1000*cos(gametime*pi/180)+0.5) || 1
ignorehitpause = 1

[State -2];ヘルパー共通ステートへ
type = SelfState
trigger1 = ishelper
value = 11111
persistent = 256
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;変数初期化
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;チームモードの二人目以降での登場
;サバイバルの相手側で二試合目以降での登場
;の場合は変数が引き継がれてしまうため初期化が必要
;
;アーケードモードの場合、１Ｐ側のみ試合を跨いで変数を引き継ぐ
;!ishometeam&&teamside=1の条件でアーケードの１Ｐ側を認識可能

[State -2];試合ごとに初期化（初期値が０以外のもの）
type = Null
triggerall = var(59) := numexplod(468746114) || 1
triggerall = var(59) = 0
triggerall = roundstate = 0 && ((!var(10)||((teammode=turns)&&!roundsexisted&&roundno!=1))||(!ishometeam&&teamside=1&&!roundsexisted))
trigger1 = var(3) := ID
trigger1 = numpartner
trigger1 = ID > partner,ID
trigger1 = var(3) := partner,ID && 0
trigger2 = var(3) > enemy(0),ID
trigger2 = var(3) := enemy(0),ID && 0
trigger3 = var(50) := -1
trigger3 = var(51) := -1
ignorehitpause = 1

[State -2];ラウンドごとに初期化
type = Null
trigger1 = var(59) = 0
trigger1 = roundstate = 0
trigger1 = var(4) := enemy(0),life || 1
trigger1 = var(5) := ifelse(var(58)=5,var(5),9) || 1
trigger1 = var(6) := life * (palno=[1,4]) || 1
trigger1 = var(7) := 0 || 1
trigger1 = var(12) := facing || 1
trigger1 = var(20) := (var(20)&-2147483136) || 1
trigger1 = var(23) := 0 || 1
trigger1 = var(26) := -1 || 1
trigger1 = fvar(0) := vel x || 1
trigger1 = fvar(1) := vel y || 1
trigger1 = fvar(2) := pos x || 1
trigger1 = fvar(3) := pos y || 1
trigger1 = fvar(7) := 0 || 1
trigger1 = fvar(8) := 0 || 1
trigger1 = fvar(12) := pos x || 1
trigger1 = fvar(13) := pos y || 1
trigger1 = fvar(14) := 1000 || 1
trigger1 = fvar(15) := 1 || 1
trigger1 = fvar(38) := 0 || 1
ignorehitpause = 1

[State -2];隔離技術利用可能性確認 + 自スロットＩＤ取得
